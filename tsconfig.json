{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./backend", 
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "node"
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}